# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Required for the AI Sheikh scholar chat powered by Groq.
# Configured server-side in environment variables / AI Studio Secrets.
GROQ_API_KEY="MY_GROQ_API_KEY"

# AGNES_API_KEY: Required for the agnes-2.5-flash model via https://apihub.agnes-ai.com/v1/chat/completions.
# Configured server-side in environment variables / AI Studio Secrets.
AGNES_API_KEY="MY_AGNES_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional HTTPS backend URL (e.g. your Vercel or Netlify site URL)
# baked into the Capacitor Android APK build so Sheikh AI calls your live API.
VITE_API_BASE_URL=""
